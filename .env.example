# ==============================================================================
# NOESIS Environment Configuration Template
# ==============================================================================

# Application Environment (development | testing | production)
APP_ENV=development
APP_NAME=NOESIS
APP_VERSION=1.0.0
DEBUG=true

# Storage Mode (neo4j | in_memory)
# If neo4j is selected but unreachable, NOESIS falls back to in_memory gracefully.
GRAPH_STORAGE_MODE=in_memory

# Neo4j Connection (Local Development Default - Override in production)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=noesis_dev_secret

# Local LLM (Ollama) Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_CONTEXT_LENGTH=2048
OLLAMA_TEMPERATURE=0
OLLAMA_CONCURRENCY=1
ALLOW_CLOUD_LLM=false
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_HEALTH_TIMEOUT_SECONDS=3
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MAX_RETRIES=0
OLLAMA_THINK=false
OLLAMA_MAX_GENERATED_TOKENS=1024

# Ingestion Settings
MAX_DOCUMENT_SIZE_MB=15
MAX_UPLOAD_FILE_SIZE_BYTES=15728640
CHUNK_SIZE_CHARS=2400
CHUNK_OVERLAP_CHARS=350
EXTRACTION_CACHE_DIR=.cache/extraction

# Server Host and Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000

# Logging Level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Reasoning Engine Limits
MAX_TRAVERSAL_HOPS=5
MAX_REASONING_PATHS=20
REASONING_TIMEOUT_SECONDS=10.0
